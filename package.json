{
  "name": "afrospeak-studio",
  "version": "1.0.0",
  "description": "Studio de génération de vidéos YouTube faceless autonome — script IA locale, voix off synchronisée mot à mot, scraping réseaux sociaux avec crédits, montage FFmpeg",
  "main": "index.js",
  "bin": {
    "afrospeak": "./index.js"
  },
  "scripts": {
    "start": "node index.js --serve",
    "serve": "node server.js",
    "doctor": "node index.js --doctor",
    "auto": "node index.js --auto",
    "watch": "node index.js --watch"
  },
  "keywords": [
    "video",
    "ffmpeg",
    "youtube",
    "faceless",
    "afrique",
    "tts",
    "ollama",
    "deepseek",
    "automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "jose": "^5.10.0"
  }
}
