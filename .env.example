# ═══════════════════════════════════════════════════════════════════
#  AfroSpeak Studio — variables d'environnement
#  Copiez ce fichier en .env (local) ou saisissez ces clés dans le
#  panneau de votre hébergeur (Render / Koyeb / Fly.io).
#  TOUT ce qui suit est optionnel : l'application démarre sans rien.
# ═══════════════════════════════════════════════════════════════════

# ───────────── 1. BASE DE DONNÉES (Neon, gratuit) ─────────────
# https://console.neon.tech → New Project → Connection string (pooled)
# Sans cette variable : magasin JSON local, perdu à chaque redémarrage.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ───────────── 2. SÉCURITÉ ─────────────
# Obligatoire en production. Générez-le : openssl rand -base64 48
AUTH_SECRET=changez-moi-par-une-chaine-aleatoire-de-48-octets

# Ferme les inscriptions une fois votre compte créé (recommandé)
DISABLE_SIGNUP=0

# Mode personnel : aucune page de connexion, tout appartient au propriétaire
SINGLE_USER=0
OWNER_EMAIL=vous@exemple.com
OWNER_PASSWORD=

# ───────────── 3. IA — SCRIPTS (au moins UNE clé recommandée) ─────────────
# Un conteneur gratuit (512 Mo) ne peut pas faire tourner Ollama :
# ces API cloud gratuites prennent le relais automatiquement.

# Groq — https://console.groq.com/keys  (~14 400 requêtes/jour, le plus rapide)
# C'est la clé qui fait passer le studio de « AfroWriter » à « Groq » au
# démarrage. Renseigne-la dans ton .env (pas ici) :
#     npm run cles -- --groq gsk_xxxxxxxx
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys  (modèles ":free" dont DeepSeek-R1)
OPENROUTER_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey  (1 500 requêtes/jour)
GEMINI_API_KEY=

# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# HuggingFace — https://huggingface.co/settings/tokens
HF_TOKEN=

# OpenAI (payant, facultatif)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ordre de préférence des fournisseurs (le premier disponible gagne).
# OpenRouter en tête : son palier gratuit est bien plus large que celui de
# Groq, dont le quota par minute (12 000 jetons) sature dès la deuxième
# requête d'une même génération et impose alors 20 s d'attente.
# Groq reste en second : très rapide, c'est un excellent filet de secours.
LLM_PROVIDER_ORDER=openrouter,groq,gemini,cerebras,huggingface

# Ollama : désactivé en conteneur, activez-le (0) sur une machine ≥ 8 Go
DISABLE_OLLAMA=1
# OLLAMA_HOST=http://127.0.0.1:11434

# ───────────── 4. STOCKAGE DES VIDÉOS (Cloudflare R2, 10 Go gratuits) ─────────────
# Le disque des hébergeurs gratuits est ÉPHÉMÈRE : sans stockage objet,
# vos vidéos disparaissent au redémarrage du conteneur.
# Cloudflare → R2 → Create bucket → Manage API tokens
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=afrospeak
S3_REGION=auto
# URL publique du bucket (R2 → Settings → Public Development URL)
S3_PUBLIC_BASE=https://pub-xxxxx.r2.dev
S3_FORCE_PATH_STYLE=0

# ───────────── 5. VOIX OFF ─────────────
# Sans clé : Google TTS gratuit (déjà fonctionnel).
# ElevenLabs donne une synchronisation mot à mot EXACTE.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# ⚠ COMMENT UTILISER CE FICHIER
# Copie-le en « .env » (sans .example) et renseigne tes clés :
#     cp .env.example .env
# ou, plus simple, laisse le studio l'écrire pour toi :
#     npm run cles -- --groq gsk_xxxxxxxx
#
# Le fichier .env est lu automatiquement au démarrage (npm start) et il est
# ignoré par git. NE JAMAIS mettre de vraie clé dans .env.example, qui est
# versionné : le dépôt est public et GitHub révoque les clés Groq exposées.

# ───────────── 6. BANQUES D'IMAGES (facultatif) ─────────────
# Sans clé : Openverse, Wikimedia, Internet Archive et NASA suffisent.
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── Recherche élargie « tout le web » (DuckDuckGo, Bing, presse GDELT) ──
# Activée par défaut : indispensable pour l'ACTUALITÉ, que les banques
# d'images libres ne couvrent pas (personnalités, sommets, sites précis).
# Ces visuels relèvent de l'usage éditorial : le crédit « Source : <média> »
# est incrusté automatiquement à l'écran.
# Mettre 0 pour n'utiliser QUE les banques libres de droits.
WEB_SEARCH=1
# Côté le plus court accepté pour une image (px) : en dessous, le visuel est
# rejeté car il pixelliserait en 1080×1920.
MIN_IMAGE_EDGE=640

# ───────────── 7. LIMITES (protègent un hébergeur gratuit) ─────────────
MAX_MINUTES=3              # durée maximale demandable
FREE_DAILY_QUOTA=5         # vidéos par utilisateur et par 24 h
RENDER_CONCURRENCY=1       # rendus simultanés — NE PAS augmenter sous 1 Go
AFROSPEAK_THREADS=1        # threads FFmpeg
FORCE_QUALITY=draft        # draft | high | max  (vide = choix utilisateur)
MAX_QUEUE=20
SOCIAL_BUDGET_MS=120000    # temps max de scraping par vidéo
AVG_JOB_SECONDS=300        # estimation d'attente affichée

# ───────────── 8. DIVERS ─────────────
PORT=7860
PUBLIC_URL=https://mon-studio.onrender.com
NODE_ENV=production

# ───────────── 9. B-ROLL VIDÉO ─────────────
# Cadence d'alternance photo/vidéo : 2 = une vidéo tous les 2 plans.
VIDEO_EVERY=2
# Octets téléchargés pour une vidéo Wikimedia (fichiers longs, on ne prend
# que le début : quelques secondes suffisent pour un plan).
VIDEO_PART_BYTES=12582912

# ───────────── 10. VISUELS GÉNÉRÉS PAR IA (§2) ─────────────
# Illustrations créées à la volée quand aucune archive n'existe.
# Fournisseur libre, sans clé. 0 pour désactiver complètement.
AI_ASSETS=1

# ───────────── 11. DROIT DE CITATION (§1) ─────────────
# Durée maximale d'un extrait tiers, en secondes.
CITATION_MAX_SECONDS=3

# ───────────── 12. QUOTAS LLM ─────────────
# Jetons par minute du palier gratuit (relevé sur les en-têtes de l'API) :
# 6000 pour les petits modèles, 12000 pour les grands. Laisser vide = auto.
LLM_TOKENS_PER_MIN=
LLM_MAX_TOKENS=6000

# ───────────── 13. COMPOSITION BIFORMAT ─────────────
# Les data callouts et split-screens s'adaptent au ratio de sortie :
#   9:16  → callout XXL centré + pill tag ; split empilé (vstack)
#   16:9  → synthé au tiers inférieur ; split côte à côte (hstack) ou PiP
# Aucun réglage requis : la composition suit le format de la vidéo.

# ───────────── 14. RYTHME DE MONTAGE ─────────────
# Cadence de coupe visée, en secondes (fenêtre de rétention 1,5-3 s).
SHOT_PACE=
# Seuil de redécoupage d'une phrase (× la cadence). 1.15 = redécoupe dès
# qu'une phrase dépasse sensiblement la cadence.
RESEG_RATIO=1.15
# Mots maximum par chunk de sous-titres (spec : 2-4).
CAPTION_MAX_WORDS=4

# ───────────── 15. HARMONISATION VISUELLE (lib/mediaTransform.js) ─────────────
# Conforme tout média externe avant montage : cadrage nettoyé, colorimétrie
# homogène, cadence alignée. 0 pour désactiver complètement.
MEDIA_TRANSFORM=1
# Réglages par défaut (bornés dans le module pour rester invisibles).
MT_ZOOM=1.05
MT_SPEED=1.04
MT_CONTRAST=1.06
MT_SATURATION=0.95
