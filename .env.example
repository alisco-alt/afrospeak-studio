# AfroSpeak Studio — variables d'environnement
# Copier en .env et renseigner les clés nécessaires. Aucune n'est obligatoire
# pour un rendu local (fallbacks libres), mais les clés Pexels/Pixabay/OpenAI
# débloquent la qualité premium.

# ── Kill-switches debug (désactivent une étape, jamais en prod) ──────────
# Mettre à '0' pour court-circuiter l'étape correspondante (retour immédiat).
# Utiles en local pour isoler un étage du pipeline. 0 test les couvre en CI.
# MONTAGE_ARBITRAGE=0        # désactive agentMonteur (appliquerArbitrageMonteur)
# MONTEUR_COMPREHENSION=0    # désactive comprehensionSujet → requêtes génériques
# MEDIA_TRANSFORM=0          # désactive mediaTransform (post-traitement visuel)
# MONTAGE_STRICT=0           # ne refuse jamais (verdict refuser → ignorer)
# PENSEUR_IA=0              # désactive le style penseur (penseur_ia.js)
# MOTION_SLIDES=0           # désactive les cartes dataSlide/motion
# ARCHIVES_VIDEO=0          # désactive la voie archivesVideo (Dailymotion/yt-dlp)

# ── Profils & modes ───────────────────────────────────────────────────────
# SOURCING_PROFILE=viral|documentaire|economie  # seuils sourcing.js (SEUILS/PROFILS)
# AFROSPEAK_RAPIDE=1        # divise timeouts par 3–4 (tests, CI)
# AFROSPEAK_QUALITY=low|high
# WEB_SEARCH=0              # revient aux seules banques libres de droits

# ── Clés API (optionnelles, premium si présentes) ───────────────────────
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# UNSPLASH_ACCESS_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# PEXELS_KEY=               # alias historique de PEXELS_API_KEY
# IA_POLLINATIONS_TOKEN=    # sk_ → gen.pollinations.ai + Bearer, sinon legacy

# ── TTS ─────────────────────────────────────────────────────────────────
# VOIX_PRINCIPALE=          # edge|eleven|openai|google
# EDGE_TTS_TIMEOUT_MS=15000
# VOIX_PROSODIE=1
# PRONONCIATION=1

# ── Rendu ───────────────────────────────────────────────────────────────
# LUT=1                     # 0 désactive la LUT 3D (lut.js)
# LUT_INTENSITE=0.22
# LUT_LOOK=ecodoc|tension|terre|neutre
# GRADE=1
# VISUAL_GRADE=1            # étalonnage documentaire (visualGrade.js) vs lut3d
# MOTION_MODE=auto
# MOTION_SCALE=1.0

# ── Timeouts & budgets (ms) ──────────────────────────────────────────────
# PIPELINE_TIMEOUT_MS=7200000
# MEDIA_BUDGET_MS=45000
# TIMEOUT_HTTP_MS=20000
# TIMEOUT_COOKIE_MS=45000

# ── Réseau & DNS (WSL2) ─────────────────────────────────────────────────
# DNS_CACHE_GLOBAL=1
# DNS_PRECHAUFFAGE=1
# RESEAU_IPV=4

# ── Auth & SaaS ─────────────────────────────────────────────────────────
# AUTH_SECRET=              # JWT
# OWNER_EMAIL=
# OWNER_PASSWORD=
# DATABASE_URL=             # Neon Postgres (prod)
# PORT=3000
