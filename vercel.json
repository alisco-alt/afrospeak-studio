{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "afrospeak-studio",
  "public": false,

  "//": "Vitrine statique. Le moteur FFmpeg tourne sur Render : Vercel plafonne à 300 s d'exécution, interdit l'écriture disque et limite le bundle à 250 Mo.",

  "buildCommand": "node scripts/build-frontend.js",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "echo 'aucune dépendance nécessaire pour la vitrine'",

  "cleanUrls": true,
  "trailingSlash": false,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],

  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
